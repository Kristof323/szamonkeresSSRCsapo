<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kategória szerinti szűrés</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <form action="" method="get">
        <label for="kategoria">Kategória:</label>
        <select name="kategoria" id="kategoria">
            <option value="elektronika">Elektronika</option>
            <option value="ruházat">Ruházat</option>
            <option value="könyv">Könyv</option>
            <option value="játék">Játék</option>
        </select>
        <button type="submit">Szűrés</button>

        <table>
            <tr>
                <th>Név</th>
                <th>Leírás</th>
                <th>Ár</th>
                <th>Készlet</th>
            </tr>
            <tbody>
                <% const selectedCategory = typeof kategoria !== 'undefined' ? kategoria : ''; %>
                <% const productList = typeof products !== 'undefined' && Array.isArray(products) ? products : []; %>
                <% productList.filter(product => !selectedCategory || (product.category ?? product.kategoria) === selectedCategory).forEach(product => { %>
                    <tr class="<%= Number(product.stock) === 0 ? 'red bold' : '' %>">
                        <td><%= product.name %></td>
                        <td><%= product.category %></td>
                        <td><%= product.price %></td>
                        <td class="<%= Number(product.stock) > 0 && Number(product.stock) < 5 ? 'red bold' : '' %>"><%= product.stock %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </form>
</body>
</html>